# Paddock Environment Variables
#
# These are optional configuration values for production deployment.
# Copy this file to .env.local for local testing.

# Sentry Error Tracking (Optional)
# Get your DSN from https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics (Optional)
# Plausible Analytics domain
# VITE_PLAUSIBLE_DOMAIN=your-domain.com

# Note: AI API keys (OpenAI, Anthropic, Gemini) are configured
# by users in-app via Settings -> AI Settings. They are stored
# client-side in IndexedDB and never sent to your server.

# Demo growing history (WebMCP demo deployments only)
# Seeds ~23 trays of plausible history so an agent has something real to reason about.
# Leave unset for real installs - a grower must never find invented trays.
# VITE_DEMO_SEED=true
